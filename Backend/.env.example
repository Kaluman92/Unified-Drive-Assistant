# Copy this file's variable names into your Vercel project's
# Environment Variables settings (Project -> Settings -> Environment
# Variables) — never commit actual key values to git. This .env.example
# file is safe to commit; a real .env file with real keys is NOT.

ANTHROPIC_API_KEY=sk-ant-your-real-key-here
OPENAI_API_KEY=sk-your-real-key-here
GEMINI_API_KEY=your-real-key-here

# Optional — override the exact model per provider without touching code.
# Verify the current recommended model in each provider's own docs before
# deploying; these change over time.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
